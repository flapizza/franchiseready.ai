NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Required by production persistence composition. Use "demo" only for local
# deterministic demo/E2E adapters; production deployments must use "supabase".
PERSISTENCE_MODE=demo
# Development only. Defaults off and is ignored unless NODE_ENV=development.
CONFERENCE_DEMO_ACCESS=false
