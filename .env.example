NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Required by production persistence composition. Use "demo" only for local
# deterministic demo/E2E adapters; production deployments must use "supabase".
PERSISTENCE_MODE=demo
# Development only. Defaults off and is ignored unless NODE_ENV=development.
CONFERENCE_DEMO_ACCESS=false

# GMAIL-001 server-only OAuth configuration. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Development only: base64 encoding of exactly 32 random bytes. Production
# fails closed until the managed-KMS CredentialCipher is configured.
GOOGLE_TOKEN_ENCRYPTION_KEY=
