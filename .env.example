NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only and reserved for narrowly scoped administrative/OAuth credential
# operations. Normal user requests must continue through RLS-bound clients.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical application origin for this environment. Do not include a path or
# trailing slash. Preview deployments need their own Preview origin.
APP_URL=http://localhost:3000
# Required by production persistence composition. Use "demo" only for local
# deterministic demo/E2E adapters; production deployments must use "supabase".
PERSISTENCE_MODE=demo
# Local development/E2E only. Production builds fail closed even when true.
CONFERENCE_DEMO_ACCESS=false

# GMAIL-001 server-only OAuth configuration. Never prefix these with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Development only: base64 encoding of exactly 32 random bytes. Production
# fails closed until the managed-KMS CredentialCipher is configured.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# No AI provider is currently required. Add future provider credentials only as
# server secrets after a provider boundary and cost controls are implemented.
